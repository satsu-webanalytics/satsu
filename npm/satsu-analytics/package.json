{
  "name": "satsu-analytics",
  "version": "0.1.3",
  "description": "Satsu analytics components, typed custom events, setup CLI and MCP server for React, Next.js, Vue/Nuxt, Astro, SvelteKit and Remix",
  "keywords": ["analytics", "privacy", "cookieless", "mcp"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satsu-webanalytics/satsu.git",
    "directory": "npm/satsu-analytics"
  },
  "homepage": "https://satsu.pro",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./astro": "./dist/astro/Satsu.astro",
    "./svelte": {
      "types": "./dist/svelte/Satsu.svelte.d.ts",
      "svelte": "./dist/svelte/Satsu.svelte",
      "default": "./dist/svelte/Satsu.svelte"
    },
    "./remix": {
      "types": "./dist/remix.d.ts",
      "default": "./dist/remix.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "satsu-analytics": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup && cp src/svelte/Satsu.svelte.d.ts dist/svelte/",
    "lint": "tsc --noEmit",
    "test": "vitest run --typecheck",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "satsu-analytics/react",
      "path": "dist/react.js",
      "import": "{ Satsu }",
      "limit": "1 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react/jsx-runtime"
      ]
    }
  ],
  "peerDependencies": {
    "astro": "^7.0.0",
    "next": ">=13",
    "nuxt": "^4.0.0",
    "react": ">=18",
    "react-router": "^7.0.0 || ^8.0.0",
    "svelte": "^5.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "next": "^16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "size-limit": "^12.0.0",
    "svelte": "^5.57.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  }
}
